# Contributor: 地震 <jishin@noreply.git.emunest.net>
# Maintainer: 地震 <jishin@noreply.git.emunest.net>
#
# wuh-wuh-worktree — git worktree switcher TUI (ratatui/crossterm) for the
# shell, using Zed's worktree layout: a project at /a/b/c/project gets its
# worktrees in /a/b/c/worktrees/project/<pet-name>/project (pet name from the
# `petname` crate). Lists worktrees most-recently-committed first, fuzzy
# filters as you type, can create/delete worktrees. A process can't cd its
# parent, so the binary prints the target (`--sh` / `--json`) and the shell
# integration function `wuh` (generated by `--init <shell>`) does the cd.
#
# This is part of the puburrow monorepo (a rolling project with no release
# tags), which also contains the sibling duh aport here. The two aports
# download the SAME monorepo archive and each build its own cli/<name>
# subdirectory out of it — bump both together: advance _commit in each
# APKBUILD and the _git<date> pkgver suffix (date = commit date of the new
# HEAD; the 0.1.0 prefix is the crate's Cargo.toml version).
#
# Runtime deps: everything is done by shelling out to `git` (hardcoded
# Command::new("git"), plumbing only so log.* config can't perturb it), so
# git is a mandatory depends. Upstream keeps the dep tree deliberately lean
# (argh not clap; ratatui with only the crossterm backend) and builds for
# size (opt-level=z, panic=abort, fat LTO) — a ~690 KiB binary linking only
# libgcc_s.so.1 + libc.musl-*.so.1, both auto/base, so so:-autoscan adds
# nothing.
pkgname=wuh-wuh-worktree
pkgver=0.1.0_git20261007
pkgrel=0
pkgdesc="Quick git worktree switcher TUI using the Zed worktree layout"
url="https://git.emunest.net/jishin/puburrow"
arch="aarch64 x86_64"
license="MIT"
depends="git"
makedepends="
	cargo
	cargo-auditable
	rust
	"
# `net`: cargo fetch in prepare() reaches crates.io (DIY repo, no vendoring —
# same idiom as the sibling dirge/orbit aports).
# `!check`: the only tests assert the generated shell-integration snippets;
# not worth a second dev-profile build of the dep tree per repo idiom.
options="net !check"
# puburrow master HEAD snapshot (commit date 2026-10-07). Gitea serves
# commit-pinned archives at /archive/<sha>.tar.gz.
_commit=948db188dc5f6c6e34b3c73b2f8fa0af8ba79aa5
source="$pkgname-$_commit.tar.gz::https://git.emunest.net/jishin/puburrow/archive/$_commit.tar.gz"
# Gitea archives extract to a top-level dir named after the repo only (no
# ref suffix); the crate lives in a cli/ subdirectory of the monorepo.
builddir="$srcdir/puburrow/cli/$pkgname"

prepare() {
	default_prepare
	# Populate the cargo cache for the host target (deterministic per
	# Cargo.lock). CI builds natively per-arch.
	cargo fetch --target="$CTARGET" --locked
}

build() {
	# --frozen = --locked + --offline; uses only what `cargo fetch` cached.
	# Pure-Rust dep tree, so no CC/CXX pinning needed (repo clang idiom only
	# matters for cc-built native code). The size-optimised release profile
	# is defined by upstream's Cargo.toml.
	cargo auditable build --frozen --release
}

package() {
	# The shell-integration functions invoke the binary by its full name;
	# install a `wuh` symlink too, since that's how the tool is referred to
	# day to day (the name of the generated shell function).
	install -D -m755 target/release/$pkgname "$pkgdir"/usr/bin/$pkgname
	ln -s $pkgname "$pkgdir"/usr/bin/wuh
}

sha512sums="
90f5d3d6b111d593587f74924b574a40ddbef9c079ad9ac7fe0736d89dea22f1e1482d2c1eb26e4d36e2f1b9da4fd4c974d8f29fafbd4696cf1145d5978464f0  wuh-wuh-worktree-948db188dc5f6c6e34b3c73b2f8fa0af8ba79aa5.tar.gz
"
